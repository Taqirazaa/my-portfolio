# BlockGuard environment example
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/blockguard

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTORSTORE_DIR=/workspace/data/vectorstore

# RAG Knowledge base
KNOWLEDGE_BASE_DIR=/workspace/data/knowledge_base
